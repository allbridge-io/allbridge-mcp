# Allbridge Core API (quotes, routes, intents, transfer status, explorer)
ALLBRIDGE_CORE_API_URL=https://api.core.allbridge.io
ALLBRIDGE_API_TIMEOUT_MS=20000

# RPC per chain: ALLBRIDGE_<CHAIN_SYMBOL>_RPC_URL. Used to read balances and allowances,
# build transactions and broadcast. Public defaults are built in but rate limited
# (trongrid allows 3 requests per second), so set your own for every chain you use.
ALLBRIDGE_ETH_RPC_URL=
ALLBRIDGE_ARB_RPC_URL=
ALLBRIDGE_BAS_RPC_URL=
ALLBRIDGE_OPT_RPC_URL=
ALLBRIDGE_POL_RPC_URL=
ALLBRIDGE_AVA_RPC_URL=
ALLBRIDGE_BSC_RPC_URL=
ALLBRIDGE_UNI_RPC_URL=
ALLBRIDGE_CEL_RPC_URL=
ALLBRIDGE_SNC_RPC_URL=
ALLBRIDGE_LIN_RPC_URL=
ALLBRIDGE_SOL_RPC_URL=
ALLBRIDGE_TRX_RPC_URL=
ALLBRIDGE_STX_RPC_URL=
# Stellar: Soroban RPC (SRB) and Horizon (STLR)
ALLBRIDGE_SRB_RPC_URL=
ALLBRIDGE_STLR_RPC_URL=
# Sui: gRPC-web base URL of a full node (Sui nodes no longer serve JSON-RPC)
ALLBRIDGE_SUI_RPC_URL=
ALLBRIDGE_SRB_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

MCP_AUTH_MODE=none
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
# Public HTTPS origin for OAuth metadata in streamable-http mode; leave unset for stdio.
# MCP_PUBLIC_BASE_URL=https://your-mcp-host.example.com
MCP_PORT=3000
# At least 16 characters, e.g. `openssl rand -hex 32`
MCP_BEARER_TOKEN=
MCP_OAUTH_ISSUER_NAME=Allbridge MCP
MCP_OAUTH_SCOPE=allbridge.mcp
MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
MCP_OAUTH_AUTH_CODE_TTL_SECONDS=600
